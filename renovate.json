{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "Europe/Rome",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Development tooling moves together and is safe to batch.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies",
      "automerge": true
    },
    {
      "description": "React and the build are updated deliberately, one at a time.",
      "matchPackageNames": ["react", "react-dom", "vite", "tailwindcss", "typescript"],
      "automerge": false
    }
  ]
}
